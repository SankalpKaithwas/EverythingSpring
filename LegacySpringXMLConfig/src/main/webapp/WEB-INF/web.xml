<?xml version="1.0" encoding="UTF-8"?>
<web-app id="WebApp_ID" version="2.4"
	xmlns="http://java.sun.com/xml/ns/j2ee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd">
	<display-name>LegacySpringXMLConfig</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
		<welcome-file>index.htm</welcome-file>
		<welcome-file>index.jsp</welcome-file>
		<welcome-file>index.xhtml</welcome-file>
		<welcome-file>default.html</welcome-file>
		<welcome-file>default.htm</welcome-file>
		<welcome-file>default.jsp</welcome-file>
		<welcome-file>default.xhtml</welcome-file>
	</welcome-file-list>


	<display-name>Spring MVC Legacy Reference</display-name>

	<!-- DispatcherServlet acts as the Front Controller -->
	<servlet>
		<servlet-name>dispatcher</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<!-- Default behavior: Spring will automatically look for: /WEB-INF/[servlet-name]-servlet.xml 
			=> /WEB-INF/dispatcher-servlet.xml -->
		<load-on-startup>1</load-on-startup>
	</servlet>

	<servlet-mapping>
		<servlet-name>dispatcher</servlet-name>
		<!-- Intercepts all incoming client requests -->
		<url-pattern>/</url-pattern>
	</servlet-mapping>
</web-app>

<!-- 1.web.xml - Defines servlet routing at the container level. Tells Tomcat 
	to forward all (/) paths to DispatcherServlet. 
	2.dispatcher-servlet.xml - Loaded automatically based on the servlet name (dispatcher). 
	Configures <mvc:annotation-driven>, <context:component-scan>, and the InternalResourceViewResolver. 
	/WEB-INF/views/ - Protected JSP folder. Files here cannot be directly requested by users via 
	URL; they can only be reached through controller forwarding. -->
